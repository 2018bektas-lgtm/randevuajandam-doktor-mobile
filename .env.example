# ── Production defaults (EAS also sets these in eas.json) ──────────────────
# Local XAMPP only if you also set EXPO_PUBLIC_USE_LOCAL_API=1
EXPO_PUBLIC_API_URL=https://randevuajandam.com/api/mobile/v1
EXPO_PUBLIC_SITE_URL=https://randevuajandam.com
# EXPO_PUBLIC_USE_LOCAL_API=1

# Legal (live on site)
EXPO_PUBLIC_PRIVACY_URL=https://randevuajandam.com/gizlilik-politikasi
EXPO_PUBLIC_TERMS_URL=https://randevuajandam.com/kullanim-kosullari
EXPO_PUBLIC_KVKK_URL=https://randevuajandam.com/kvkk

# Play package (must match app.json android.package)
EXPO_PUBLIC_PLAY_PACKAGE_ID=com.randevuajandam.doktor

# App Store Connect → App → Apple ID (numeric). Optional until iOS release.
EXPO_PUBLIC_APP_STORE_ID=

# RevenueCat public SDK keys (Project settings → API keys). Optional until IAP.
# Set also as EAS secrets for production builds:
#   eas secret:create --name EXPO_PUBLIC_REVENUECAT_IOS_KEY --value appl_...
#   eas secret:create --name EXPO_PUBLIC_REVENUECAT_ANDROID_KEY --value goog_...
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Sentry (optional). Prefer EAS secret for production:
#   eas secret:create --name EXPO_PUBLIC_SENTRY_DSN --value https://...@....ingest.sentry.io/...
EXPO_PUBLIC_SENTRY_DSN=

# ── iOS push ───────────────────────────────────────────────────────────────
# Place Firebase iOS file next to google-services.json:
#   GoogleService-Info.plist
# app.config.js attaches it automatically when the file exists.
